/* 分类入口页 */
.page { min-height: 100vh; background: var(--paper); padding-bottom: 160rpx; }

/* Tab */
.tabs { display: flex; gap: 16rpx; padding: 24rpx 32rpx; box-sizing: border-box; }
.tab { flex: 1; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; background: #ece7da; color: var(--ink-3); font-size: 24rpx; }
.tab.is-on { background: var(--ink); color: #fffdf8; }

.sec-content { padding: 0 32rpx; box-sizing: border-box; }
.scene-list { display: flex; flex-direction: column; gap: 20rpx; }
.scene-card, .exam-card, .ability-card { display: flex; align-items: center; padding: 28rpx 24rpx; }
.scene-icon, .exam-icon, .ability-icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 24rpx; flex: none; margin-right: 24rpx; }
.scene-icon--blue  { background: rgba(36, 63, 79, 0.10); }
.scene-icon--green { background: rgba(79, 122, 93, 0.12); }
.scene-icon--gold  { background: rgba(201, 151, 90, 0.14); }
.scene-icon--red   { background: rgba(201, 74, 74, 0.10); }
.scene-icon--purple{ background: rgba(100, 70, 120, 0.10); }
.exam-icon--green { background: rgba(79, 122, 93, 0.12); }
.exam-icon--red   { background: rgba(201, 74, 74, 0.10); }
.ability-icon--easy { background: rgba(79, 122, 93, 0.12); }
.ability-icon--mid  { background: rgba(201, 151, 90, 0.14); }
.ability-icon--hard { background: rgba(201, 74, 74, 0.10); }
.scene-icon-img, .exam-icon-img, .ability-icon-img { width: 40rpx; height: 40rpx; }
.scene-body, .exam-left, .ability-body { flex: 1; min-width: 0; }
.scene-name, .exam-name, .ability-name { display: block; font-size: 30rpx; color: var(--ink); font-weight: 600; letter-spacing: 2rpx; }
.scene-desc, .exam-desc, .ability-desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--ink-3); line-height: 1.5; }
.scene-arrow { width: 28rpx; height: 28rpx; opacity: 0.35; flex: none; margin-left: 16rpx; }
.ability-list { display: flex; flex-direction: column; gap: 20rpx; }