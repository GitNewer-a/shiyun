<view class="page">
  <!-- Tab 切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === idx ? 'is-on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-idx="{{idx}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <!-- 按场景 -->
  <view wx:if="{{activeTab === 0}}" class="sec-content">
    <view class="scene-list">
      <navigator class="scene-card card" url="/pages/textbook/textbook" hover-class="none">
        <view class="scene-icon scene-icon--blue"><image src="/assets/figma-learn/icon-9.svg" class="scene-icon-img" mode="aspectFit" /></view>
        <view class="scene-body">
          <text class="scene-name">课本必背</text>
          <text class="scene-desc">小学 / 初中 / 高中</text>
        </view>
        <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
      </navigator>
      <navigator class="scene-card card" url="/pages/category/category" hover-class="none">
        <view class="scene-icon scene-icon--green"><image src="/assets/figma-learn/icon-4.svg" class="scene-icon-img" mode="aspectFit" /></view>
        <view class="scene-body">
          <text class="scene-name">古诗启蒙</text>
          <text class="scene-desc">适合小学生的经典诗词</text>
        </view>
        <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
      </navigator>
      <navigator class="scene-card card" url="/pages/category/category" hover-class="none">
        <view class="scene-icon scene-icon--gold"><image src="/assets/figma-learn/icon-7.svg" class="scene-icon-img" mode="aspectFit" /></view>
        <view class="scene-body">
          <text class="scene-name">主题学习</text>
          <text class="scene-desc">山水田园 · 思乡怀人 · 边塞征战</text>
        </view>
        <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
      </navigator>
      <navigator class="scene-card card" url="/pages/category/category" hover-class="none">
        <view class="scene-icon scene-icon--red"><image src="/assets/figma-learn/icon-1.svg" class="scene-icon-img" mode="aspectFit" /></view>
        <view class="scene-body">
          <text class="scene-name">诗词赏析</text>
          <text class="scene-desc">深度解读，提升文学素养</text>
        </view>
        <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
      </navigator>
      <view class="scene-card card" bindtap="toastReciteSoon">
        <view class="scene-icon scene-icon--purple"><image src="/assets/figma-learn/icon-13.svg" class="scene-icon-img" mode="aspectFit" /></view>
        <view class="scene-body">
          <text class="scene-name">朗诵练习</text>
          <text class="scene-desc">跟读朗诵，提升表达力</text>
        </view>
        <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 按考试 -->
  <view wx:if="{{activeTab === 1}}" class="sec-content">
    <navigator class="exam-card card" url="/pages/exam/exam?type=zhongkao" hover-class="none">
      <view class="exam-left">
        <view class="exam-icon exam-icon--green"><image src="/assets/figma-learn/icon-7.svg" class="exam-icon-img" mode="aspectFit" /></view>
        <view>
          <text class="exam-name">中考篇</text>
          <text class="exam-desc">中考常考 · 高效备考</text>
        </view>
      </view>
      <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
    </navigator>
    <navigator class="exam-card card" url="/pages/exam/exam?type=gokao" hover-class="none">
      <view class="exam-left">
        <view class="exam-icon exam-icon--red"><image src="/assets/figma-learn/icon-11.svg" class="exam-icon-img" mode="aspectFit" /></view>
        <view>
          <text class="exam-name">高考篇</text>
          <text class="exam-desc">高考常考 · 深度解读</text>
        </view>
      </view>
      <image src="/assets/figma-learn/icon-5.svg" class="scene-arrow" mode="aspectFit" />
    </navigator>
  </view>

  <!-- 按能力 -->
  <view wx:if="{{activeTab === 2}}" class="sec-content">
    <view class="ability-list">
      <navigator class="ability-card card" url="/pages/category/category" hover-class="none">
        <view class="ability-icon ability-icon--easy"><image src="/assets/figma-learn/icon-1.svg" class="ability-icon-img" mode="aspectFit" /></view>
        <view class="ability-body">
          <text class="ability-name">入门</text>
          <text class="ability-desc">五言绝句，字浅意深</text>
        </view>
      </navigator>
      <navigator class="ability-card card" url="/pages/category/category" hover-class="none">
        <view class="ability-icon ability-icon--mid"><image src="/assets/figma-learn/icon-4.svg" class="ability-icon-img" mode="aspectFit" /></view>
        <view class="ability-body">
          <text class="ability-name">进阶</text>
          <text class="ability-desc">七言律诗，对仗工整</text>
        </view>
      </navigator>
      <navigator class="ability-card card" url="/pages/category/category" hover-class="none">
        <view class="ability-icon ability-icon--hard"><image src="/assets/figma-learn/icon-7.svg" class="ability-icon-img" mode="aspectFit" /></view>
        <view class="ability-body">
          <text class="ability-name">高阶</text>
          <text class="ability-desc">词曲长调，深度赏析</text>
        </view>
      </navigator>
    </view>
  </view>
</view>