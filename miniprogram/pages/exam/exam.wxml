<view class="page">
  <!-- 顶部标签 -->
  <view class="exam-tags">
    <view class="exam-tag {{activeTag === 'all' ? 'is-on' : ''}}" data-tag="all" bindtap="switchTag">全部</view>
    <view class="exam-tag {{activeTag === '必考' ? 'is-on' : ''}}" data-tag="必考" bindtap="switchTag">必考题</view>
    <view class="exam-tag {{activeTag === '阅读' ? 'is-on' : ''}}" data-tag="阅读" bindtap="switchTag">阅读理解</view>
    <view class="exam-tag {{activeTag === '鉴赏' ? 'is-on' : ''}}" data-tag="鉴赏" bindtap="switchTag">诗词鉴赏</view>
  </view>

  <!-- 诗词列表 -->
  <view class="poem-list">
    <view class="poem-card card" wx:for="{{poems}}" wx:key="id" data-id="{{item.id}}" bindtap="goPoem">
      <view class="poem-cover" style="background:{{item.coverBg}}" />
      <view class="poem-body">
        <text class="poem-title serif">{{item.title}}</text>
        <text class="poem-author">{{item.author}} · {{item.dynasty}}</text>
        <view class="poem-tags">
          <text class="poem-tag" wx:for="{{item.tags || ['必考']}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
      <image src="/assets/figma-learn/icon-5.svg" class="poem-arrow" mode="aspectFit" />
    </view>
  </view>
</view>