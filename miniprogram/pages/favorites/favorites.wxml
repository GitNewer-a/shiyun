<view class="page">
  <view class="pc-list">
    <view class="pc-card" wx:for="{{list}}" wx:key="id" bindtap="goPoem" data-id="{{item.id}}">
      <view class="pc-img" style="background:{{item.coverBg}}" />
      <view class="pc-main">
        <text class="pc-title serif">{{item.title}}</text>
        <text class="pc-sub">{{item.dynasty}} · {{item.author}}</text>
      </view>
      <view class="pc-star is-on" catchtap="toggleFav" data-id="{{item.id}}" aria-label="取消收藏" />
    </view>
  </view>

  <view class="ph" wx:if="{{list.length === 0}}">
    <view class="ph-seal state-empty" />
    <text class="ph-title serif">还没有收藏</text>
    <text class="ph-desc">在诗词库点星标，把喜欢的诗收进来</text>
    <navigator class="ph-todo" url="/pages/browse/browse">去诗词库看看</navigator>
  </view>
</view>
