/* 学习记录 —— Figma 58:2，宣纸系 */

.page {
  min-height: 100vh;
  background: #f8f4ea;
  color: #243447;
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: #f8f4ea;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 44px;
  padding: 0 28rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 29rpx;
  background: #ece7da;
  flex: none;
}

.nav-back-ico {
  width: 32rpx;
  height: 32rpx;
}

.nav-side {
  width: 58rpx;
  height: 58rpx;
  flex: none;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  line-height: 54rpx;
  color: #243447;
}

.scroll {
  box-sizing: border-box;
  height: 100vh;
}

.streak-card {
  position: relative;
  margin: 8rpx 28rpx 0;
  padding: 24rpx 26rpx 22rpx;
  border-radius: 32rpx;
  background: #2c4b59;
  box-shadow: 0 22rpx 42rpx rgba(36, 63, 79, 0.17);
  overflow: hidden;
}

.streak-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.streak-label {
  display: block;
  font-size: 20rpx;
  line-height: 30rpx;
  letter-spacing: 3rpx;
  color: #b9c8c8;
}

.streak-num-row {
  display: flex;
  align-items: flex-end;
  margin-top: 6rpx;
}

.streak-num {
  font-size: 76rpx;
  line-height: 76rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.streak-unit {
  margin: 0 0 8rpx 8rpx;
  font-size: 26rpx;
  line-height: 26rpx;
  color: #e1be80;
}

.streak-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #cfdad6;
}

.streak-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: rgba(225, 190, 128, 0.16);
  flex: none;
}

.streak-flame {
  width: 40rpx;
  height: 40rpx;
}

.streak-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
}

.streak-dot {
  width: 30rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.18);
}

.streak-dot.is-on {
  background: #e1be80;
}

.metric-row {
  display: flex;
  gap: 14rpx;
  margin: 14rpx 28rpx 0;
}

.metric-card {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 12rpx rgba(74, 69, 51, 0.05);
}

.metric-num-row {
  display: flex;
  align-items: flex-end;
}

.metric-num {
  font-size: 50rpx;
  line-height: 55rpx;
  font-weight: 700;
  color: #243f4f;
}

.metric-unit {
  margin: 0 0 8rpx 6rpx;
  font-size: 20rpx;
  line-height: 22rpx;
  color: #7e8886;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #7b8582;
}

.card {
  margin: 14rpx 28rpx 0;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 13rpx rgba(74, 69, 51, 0.05);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-nav {
  display: flex;
  align-items: center;
  min-width: 0;
}

.month-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.month-btn.is-disabled {
  opacity: 0.28;
}

.month-chev {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #3d6172;
  border-right: 3rpx solid #3d6172;
}

.month-chev--left {
  margin-left: 4rpx;
  transform: rotate(-135deg);
}

.month-chev--right {
  margin-right: 4rpx;
  transform: rotate(45deg);
}

.month-pick {
  display: flex;
  align-items: center;
  padding: 0 4rpx;
}

.card-title {
  margin: 0 4rpx;
  font-size: 30rpx;
  line-height: 45rpx;
  color: #243447;
}

.month-pick-caret {
  width: 10rpx;
  height: 10rpx;
  margin: 2rpx 0 0 2rpx;
  border-right: 3rpx solid #7c8885;
  border-bottom: 3rpx solid #7c8885;
  transform: rotate(45deg);
  flex: none;
}

.card-sub {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #9aa09b;
}

.legend {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  margin-right: 6rpx;
  border-radius: 7rpx;
  background: #e4dfd4;
}

.legend-dot.is-on {
  margin-left: 0;
  background: #3d6172;
}

.legend-text {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #8d938e;
}

.cal-week,
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-week {
  margin-top: 14rpx;
}

.cal-wd,
.cal-cell {
  width: 14.28%;
  text-align: center;
}

.cal-wd {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #9ea49e;
}

.cal-grid {
  margin-top: 12rpx;
}

.cal-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  margin-bottom: 10rpx;
}

.cal-cell text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #7c8480;
}

.cal-cell.is-on text {
  background: #3d6172;
  color: #f5f1e6;
  font-weight: 600;
}

.cal-cell.is-today text {
  box-shadow: 0 0 0 4rpx #fffdf8, 0 0 0 7rpx #c94a4a;
}

.chart {
  position: relative;
  margin-top: 14rpx;
  height: 264rpx;
}

.chart-lines {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 224rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chart-line {
  height: 2rpx;
  background: #efeade;
}

.chart-bars {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  height: 224rpx;
  gap: 12rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  position: relative;
}

.chart-val {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #7c8885;
}

.chart-val.is-today {
  font-weight: 600;
  color: #c94a4a;
}

.chart-bar {
  width: 52rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #3d6172;
}

.chart-bar.is-today {
  background: #c94a4a;
}

.chart-day {
  position: absolute;
  top: 236rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #98a09b;
}

.chart-day.is-today {
  color: #c94a4a;
  font-weight: 600;
}

.chart-day.is-future {
  color: #c5cbc6;
}

.chart-col.is-future .chart-bar {
  background: transparent;
}

.chart-note {
  display: block;
  margin-top: 24rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #98a09b;
}

.all-link {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #7c8885;
}

.all-ico {
  width: 22rpx;
  height: 22rpx;
  margin-left: 4rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #f6f2e7;
}

.recent-item + .recent-item {
  margin-top: 12rpx;
}

.recent-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 68rpx;
  margin-right: 16rpx;
  background: #c94a4a;
  flex: none;
}

.recent-mark text {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff8ec;
}

.recent-body {
  flex: 1;
  min-width: 0;
}

.recent-title {
  display: block;
  font-size: 26rpx;
  line-height: 39rpx;
  font-weight: 700;
  color: #243f4f;
}

.recent-verse {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #7e8783;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.recent-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #a3a89f;
}

.recent-arrow {
  width: 26rpx;
  height: 26rpx;
  margin-left: 8rpx;
  flex: none;
}

.bottom-pad {
  height: 32rpx;
}

.is-press {
  opacity: 0.72;
}
