<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="goBack" hover-class="is-press" aria-label="返回">
        <image class="nav-back-ico" src="/assets/figma-growth/back.svg" mode="aspectFit" />
      </view>
      <text class="nav-title serif">学习记录</text>
      <view class="nav-side" />
    </view>
  </view>

  <scroll-view class="scroll" scroll-y show-scrollbar="{{false}}">
    <view style="height: {{navOffset}}px;" />

    <!-- 连续学习 -->
    <view class="streak-card">
      <view class="streak-main">
        <view class="streak-copy">
          <text class="streak-label">连续学习</text>
          <view class="streak-num-row">
            <text class="streak-num serif">{{streak}}</text>
            <text class="streak-unit">天</text>
          </view>
          <text class="streak-hint">{{streakHint}}</text>
        </view>
        <view class="streak-badge">
          <image class="streak-flame" src="/assets/figma-growth/flame.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="streak-dots">
        <view class="streak-dot {{item.on ? 'is-on' : ''}}" wx:for="{{streakDots}}" wx:key="id" />
      </view>
    </view>

    <!-- 概览双卡 -->
    <view class="metric-row">
      <view class="metric-card">
        <view class="metric-num-row">
          <text class="metric-num serif">{{learned}}</text>
          <text class="metric-unit">首</text>
        </view>
        <text class="metric-label">已学习诗词</text>
      </view>
      <view class="metric-card">
        <view class="metric-num-row">
          <text class="metric-num serif">{{weekMinutesTotal}}</text>
          <text class="metric-unit">分钟</text>
        </view>
        <text class="metric-label">本周学习时长</text>
      </view>
    </view>

    <!-- 学习日历 -->
    <view class="card">
      <view class="card-head">
        <view class="month-nav">
          <view class="month-btn" bindtap="prevMonth" hover-class="is-press" aria-label="上一月">
            <view class="month-chev month-chev--left" />
          </view>
          <picker
            mode="date"
            fields="month"
            value="{{pickerValue}}"
            start="{{pickerStart}}"
            end="{{pickerEnd}}"
            bindchange="onMonthPick"
          >
            <view class="month-pick" hover-class="is-press">
              <text class="card-title serif">{{monthLabel}}</text>
              <view class="month-pick-caret" />
            </view>
          </picker>
          <view
            class="month-btn {{canGoNext ? '' : 'is-disabled'}}"
            bindtap="nextMonth"
            hover-class="{{canGoNext ? 'is-press' : ''}}"
            aria-label="下一月"
          >
            <view class="month-chev month-chev--right" />
          </view>
        </view>
        <view class="legend">
          <view class="legend-dot is-on" />
          <text class="legend-text">已学习</text>
          <view class="legend-dot" />
          <text class="legend-text">未学习</text>
        </view>
      </view>
      <view class="cal-week">
        <text class="cal-wd" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view
          class="cal-cell {{item.empty ? 'is-empty' : ''}} {{item.studied ? 'is-on' : ''}} {{item.isToday ? 'is-today' : ''}}"
          wx:for="{{cells}}"
          wx:key="id"
          data-day="{{item.day}}"
          data-studied="{{item.studied}}"
          bindtap="onDay"
        >
          <text wx:if="{{!item.empty}}">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 学习时长（可切换历史周） -->
    <view class="card">
      <view class="card-head">
        <view class="month-nav">
          <view class="month-btn" bindtap="prevWeek" hover-class="is-press" aria-label="上一周">
            <view class="month-chev month-chev--left" />
          </view>
          <picker
            mode="date"
            value="{{weekPickerValue}}"
            start="{{weekPickerStart}}"
            end="{{weekPickerEnd}}"
            bindchange="onWeekPick"
          >
            <view class="month-pick" hover-class="is-press">
              <text class="card-title serif">{{weekLabel}}</text>
              <view class="month-pick-caret" />
            </view>
          </picker>
          <view
            class="month-btn {{canGoNextWeek ? '' : 'is-disabled'}}"
            bindtap="nextWeek"
            hover-class="{{canGoNextWeek ? 'is-press' : ''}}"
            aria-label="下一周"
          >
            <view class="month-chev month-chev--right" />
          </view>
        </view>
        <text class="card-sub">单位：分钟</text>
      </view>
      <view class="chart">
        <view class="chart-lines">
          <view class="chart-line" />
          <view class="chart-line" />
          <view class="chart-line" />
        </view>
        <view class="chart-bars">
          <view class="chart-col {{item.isFuture ? 'is-future' : ''}}" wx:for="{{weekBars}}" wx:key="day">
            <text class="chart-val {{item.isToday ? 'is-today' : ''}}" wx:if="{{!item.isFuture}}">{{item.minutes}}</text>
            <view
              class="chart-bar {{item.isToday ? 'is-today' : ''}}"
              style="height: {{item.height}}rpx;"
            />
            <text class="chart-day {{item.isToday ? 'is-today' : ''}} {{item.isFuture ? 'is-future' : ''}}">{{item.day}}</text>
          </view>
        </view>
      </view>
      <text class="chart-note">{{chartNote}}</text>
    </view>

    <!-- 最近学习 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title serif">最近学习</text>
        <view class="all-link" bindtap="goAll" hover-class="is-press">
          <text>全部</text>
          <image class="all-ico" src="/assets/figma-growth/chevron.svg" mode="aspectFit" />
        </view>
      </view>
      <view
        class="recent-item"
        wx:for="{{recent}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goPoem"
        hover-class="is-press"
      >
        <view class="recent-mark">
          <text>{{item.mark}}</text>
        </view>
        <view class="recent-body">
          <text class="recent-title serif">{{item.title}}</text>
          <text class="recent-verse">{{item.verse}}</text>
          <text class="recent-meta">{{item.meta}}</text>
        </view>
        <image class="recent-arrow" src="/assets/figma-growth/arrow.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="bottom-pad" />
  </scroll-view>
</view>
