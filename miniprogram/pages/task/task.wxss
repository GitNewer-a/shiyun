/* 任务中心页 */
.page { min-height: 100vh; background: var(--paper); padding-bottom: 160rpx; }

.sec-head { display: flex; align-items: baseline; justify-content: space-between; margin: 40rpx 32rpx 20rpx; box-sizing: border-box; }
.sec-title { font-size: var(--fs-17); letter-spacing: 0.1em; color: var(--ink); }
.sec-more { font-size: var(--fs-11); color: var(--ink-3); }

/* 每日打卡卡 */
.daily-card { margin: 24rpx 32rpx; padding: 28rpx; display: flex; align-items: center; justify-content: space-between; }
.daily-left { display: flex; align-items: center; gap: 20rpx; }
.daily-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: rgba(79,122,93,.12); display: flex; align-items: center; justify-content: center; }
.daily-icon-img { width: 36rpx; height: 36rpx; }
.daily-title { display: block; font-size: 30rpx; color: var(--ink); font-weight: 600; }
.daily-sub { display: block; font-size: 20rpx; color: var(--ink-3); margin-top: 6rpx; }
.daily-cta { padding: 14rpx 32rpx; border-radius: 28rpx; background: var(--bamboo); color: #f5ede0; font-size: 24rpx; }
.daily-cta.is-done-btn { background: #ece7da; color: var(--ink-3); }

/* 任务列表 */
.task-list { padding: 0 32rpx; box-sizing: border-box; display: flex; flex-direction: column; gap: 16rpx; }
.task-item { display: flex; align-items: center; padding: 24rpx; }
.task-item.is-done .task-name { color: var(--ink-4); text-decoration: line-through; }
.task-item.is-done .task-desc { color: var(--ink-5); }
.task-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; flex: none; margin-right: 20rpx; }
.task-icon-img { width: 32rpx; height: 32rpx; }
.task-body { flex: 1; min-width: 0; }
.task-name { display: block; font-size: 26rpx; color: var(--ink); }
.task-desc { display: block; font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }
.task-check { width: 44rpx; height: 44rpx; flex: none; margin-left: 16rpx; border: 2rpx solid var(--ink-5); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.check-mark { width: 12rpx; height: 20rpx; border-right: 3rpx solid transparent; border-bottom: 3rpx solid transparent; transform: rotate(45deg) translate(-2rpx, -2rpx); opacity: 0; transition: opacity .2s; }
.check-mark.is-on { opacity: 1; border-color: #fffdf8; background: var(--bamboo); border-radius: 4rpx; width: 24rpx; height: 24rpx; transform: rotate(0); }