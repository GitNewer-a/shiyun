/* 关于诗韵
   宣纸系页面，令牌见 app.wxss。
*/

.about-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--paper);
  padding: 0 40rpx 80rpx;
}

/* 顶部：返回 + 居中标题 */
/* 品牌区 */
.about-brand {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-seal {
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  background: linear-gradient(167deg, #2c4b59 0%, #3d6455 100%);
  box-shadow: 0 20rpx 40rpx rgba(36, 52, 71, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-seal-char {
  font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  font-size: 80rpx;
  color: #fffdf8;
}

.about-name {
  margin-top: 32rpx;
  font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  font-size: 42rpx;
  letter-spacing: 0.2em;
  color: var(--ink);
}

.about-slogan {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  letter-spacing: 0.08em;
}

/* 卡片 */
.about-card {
  margin-top: 40rpx;
  padding: 32rpx;
  background: var(--paper-card);
  border-radius: 32rpx;
  box-shadow: var(--sh-light);
}

.about-card-title {
  display: block;
  font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  font-size: 24rpx;
  color: #8a8f88;
  letter-spacing: 0.12em;
  margin-bottom: 16rpx;
}

.about-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(36, 52, 71, 0.06);
}

.about-card-row:last-child {
  border-bottom: none;
}

.about-card-label {
  font-size: 26rpx;
  color: var(--ink-card);
}

.about-card-value {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 功能一览 */
.about-feat-list {
  display: flex;
  flex-direction: column;
}

.about-feat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(36, 52, 71, 0.06);
}

.about-feat-item:last-child {
  border-bottom: none;
}

.about-feat-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-card);
}

.about-feat-desc {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 设计语言说明 */
.about-design-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.9;
  color: var(--ink-2);
}

/* 落款 */
.about-catchphrase {
  margin-top: 80rpx;
  text-align: center;
}

.about-catchphrase-text {
  font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  font-size: 20rpx;
  color: #b4b0a5;
  letter-spacing: 0.3em;
}
