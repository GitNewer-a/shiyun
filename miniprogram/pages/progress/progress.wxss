/* 学习记录 —— 宣纸系（设计文档 §4.8 / §5 图表规范） */

.pg-streak {
  padding: 48rpx 32rpx;
  text-align: center;
}

.pg-streak-num {
  font-size: 152rpx;
  line-height: 1;
  color: var(--cinnabar);
}

.pg-streak-unit {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-12);
  letter-spacing: 0.16em;
  color: var(--ink-2);
}

.pg-week {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}

.pg-week-dot {
  width: 36rpx;
  height: 36rpx;
  margin: 0 10rpx;
  border-radius: 10rpx;
  background: var(--paper-sunken);
}

.pg-week-dot.is-on {
  background: var(--cinnabar);
}

.pg-metrics {
  display: flex;
  margin-top: 24rpx;
  padding: 32rpx 0;
}

.pg-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pg-metric-num {
  font-size: var(--fs-27);
  color: var(--ink);
}

.pg-metric-label {
  margin-top: 8rpx;
  font-size: var(--fs-10);
  color: var(--ink-3);
}

/* 柱状图：单序列、单色、柱宽 64%、柱顶 4px 圆角、无图例 */
.pg-chart {
  padding: 32rpx;
}

.pg-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #efeade;
}

.pg-bar-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: 64rpx;
  height: 100%;
}

.pg-bar {
  width: 40rpx;
  min-height: 8rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #3d6172;
}

.pg-bar.is-today {
  background: var(--cinnabar);
}

.pg-bar-val {
  font-size: var(--fs-10);
  margin-bottom: 8rpx;
  color: var(--ink-4);
}

.pg-bar-val.is-today {
  color: var(--cinnabar);
}

.pg-bar-day {
  position: absolute;
  bottom: -36rpx;
  font-size: var(--fs-10);
  color: var(--ink-3);
}

.pg-note {
  display: block;
  margin-top: 32rpx;
  font-size: var(--fs-11);
  color: var(--ink-2);
}

.pg-recent {
  overflow: hidden;
}

.pg-recent-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(36, 52, 71, 0.06);
}

.pg-recent-item:last-child {
  border-bottom: none;
}

.pg-recent-title {
  font-size: var(--fs-15);
  letter-spacing: 0.06em;
}

.pg-recent-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-10);
  color: var(--ink-3);
}
