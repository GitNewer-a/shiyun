/* 诗词详情 —— Figma 11:819 沉浸夜景还原 */

.poem {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #141c18;
}

/* ── 夜景山水 ── */
.poem-scene,
.poem-bg,
.poem-dim {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.poem-scene { z-index: 0; overflow: hidden; background: linear-gradient(180deg, #1a2820 0%, #121a16 42%, #0e1412 100%); }
.scene-glow {
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 210, 170, 0.28) 0%, rgba(232, 210, 170, 0.06) 42%, transparent 70%);
}
.scene-moon {
  position: absolute;
  top: 88rpx;
  right: 96rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(236, 220, 186, 0.92);
  box-shadow: 0 0 48rpx 12rpx rgba(232, 210, 170, 0.28);
}
.scene-hill {
  position: absolute;
  bottom: 0;
  border-radius: 50% 50% 0 0;
}
.scene-hill--far {
  left: -120rpx;
  width: 620rpx;
  height: 420rpx;
  background: rgba(46, 68, 58, 0.45);
}
.scene-hill--mid {
  right: -160rpx;
  width: 680rpx;
  height: 380rpx;
  background: rgba(32, 50, 42, 0.55);
}
.scene-hill--near {
  left: -80rpx;
  width: 520rpx;
  height: 260rpx;
  background: rgba(22, 36, 30, 0.7);
}
.scene-mist {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 180rpx;
  height: 220rpx;
  background: linear-gradient(180deg, transparent, rgba(180, 200, 190, 0.06), transparent);
}
.poem-bg { z-index: 1; width: 100%; height: 100%; filter: brightness(0.7) saturate(1.1); }
.poem-dim {
  z-index: 2;
  background: linear-gradient(180deg, rgba(12, 18, 16, 0.28) 0%, rgba(12, 18, 16, 0.55) 100%);
}

.poem-scroll,
.poem-action-bar { position: relative; z-index: 3; }

.poem-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto;
}

.title-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx 0;
}
.poem-fav {
  position: absolute;
  top: 12rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.18);
}
.poem-fav-ico { width: 36rpx; height: 36rpx; }
.title-chars {
  display: flex;
  gap: 18rpx;
}
.char-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.char-pinyin {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--immerse-sub);
  line-height: 1;
  min-height: 1em;
}
.char-glyph {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  flex-wrap: nowrap;
  height: 1.15em;
  font-size: 52rpx;
}
.char-punct-slot {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  width: 0.55em;
  height: 100%;
  margin-left: -0.06em;
  overflow: visible;
}
.char-main {
  font-size: 1em;
  letter-spacing: 0.06em;
  color: var(--immerse-title);
  font-weight: 600;
  line-height: 1.15;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
}
.char-main--punct {
  width: 1em;
  line-height: 1;
  /* 全角标点墨心偏中，贴到汉字底边 */
  transform: translateY(0.00em);
}
.title-divider {
  width: 56rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-top: 22rpx;
  border-radius: 1rpx;
}
.author-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}
.author-dynasty {
  font-size: 24rpx;
  color: #9eb8a8;
  letter-spacing: 0.08em;
  padding-bottom: 4rpx;
}
.author-col { gap: 6rpx; }
.author-col .char-glyph { font-size: 40rpx; }
.author-pinyin { font-size: 18rpx; }
.author-main { font-weight: 500; }

/* ── 诗句玻璃卡 ── */
.card-poem {
  margin: 32rpx 24rpx 0;
  padding: 36rpx 20rpx 28rpx;
  border-radius: 18rpx;
}
.poem-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}
.poem-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}
.char-pair {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 48rpx;
  flex-shrink: 0;
}
.line-glyph {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  flex-wrap: nowrap;
  height: 1.2em;
  font-size: var(--fs-21);
}
.line-punct-slot {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  width: 0.5em;
  height: 100%;
  margin-left: -0.04em;
  overflow: visible;
}
.line-pinyin {
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: rgba(200, 220, 210, 0.62);
  line-height: 1.2;
  min-height: 1.2em;
  white-space: nowrap;
}
.line-pinyin.is-hidden {
  height: 0;
  min-height: 0;
  overflow: hidden;
  opacity: 0;
  margin: 0;
}
.line-char {
  font-size: 1em;
  color: var(--immerse-text);
  letter-spacing: 0.08em;
  line-height: 1.2;
}
/* 槽位贴底 + 微调，使标点与汉字底部齐平 */
.line-char--punct {
  width: 1em;
  line-height: 1;
  transform: translateY(0.00em);
}
.pinyin-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 28rpx;
}
.switch {
  position: relative;
  width: 64rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.2);
  transition: background 0.2s;
}
.switch--on { background: var(--cinnabar); }
.switch-knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fffdf8;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.2s;
}
.switch--on .switch-knob { transform: translateX(30rpx); }
.toggle-label {
  font-size: 22rpx;
  color: rgba(200, 220, 210, 0.62);
}

/* ── 播放器 ── */
.card-player {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx 22rpx;
  border-radius: 18rpx;
}
.progress-bar-wrap {
  position: relative;
  width: 100%;
  height: 28rpx;
  display: flex;
  align-items: center;
}
.progress-track {
  width: 100%;
  height: 6rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.14);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(220, 200, 160, 0.95) 0%, rgba(232, 184, 112, 0.75) 100%);
}
.progress-knob {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  margin-top: -8rpx;
  border-radius: 50%;
  background: rgba(220, 200, 160, 0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
  pointer-events: none;
}
.time-labels {
  display: flex;
  justify-content: space-between;
  margin: 6rpx 0 18rpx;
}
.time-label {
  font-size: 18rpx;
  color: rgba(200, 220, 210, 0.65);
  letter-spacing: 0.04em;
}
.player-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.speed-btn {
  width: 72rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  flex: none;
}
.speed-btn text {
  font-size: 20rpx;
  color: var(--immerse-text);
  font-weight: 500;
}
.ctrl-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.ctrl-ico { width: 40rpx; height: 40rpx; opacity: 0.78; }
.play-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: rgba(220, 200, 160, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.32);
}
.ico-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 26rpx solid rgba(36, 52, 71, 0.88);
}
.ico-pause {
  width: 8rpx;
  height: 28rpx;
  background: rgba(36, 52, 71, 0.88);
  border-radius: 2rpx;
  box-shadow: 16rpx 0 0 rgba(36, 52, 71, 0.88);
  margin-right: 16rpx;
}

/* ── 知识点 ── */
.kn-section {
  margin: 24rpx 24rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
  padding-bottom: 8rpx;
}
.kn-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}
.kn-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  font-size: 28rpx;
  color: rgba(200, 220, 210, 0.62);
  position: relative;
}
.kn-tab.is-on {
  color: var(--immerse-text);
  font-weight: 600;
}
.kn-tab.is-on::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 4rpx;
  background: var(--cinnabar);
  border-radius: 2rpx;
}
.kn-content { padding: 20rpx 16rpx 24rpx; }
.kn-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
}
.kn-label {
  width: 72rpx;
  min-height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.12);
}
.kn-label-text {
  font-size: 20rpx;
  color: var(--immerse-text);
  letter-spacing: 0.12em;
  line-height: 1.3;
  text-align: center;
}
.kn-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--immerse-body);
  letter-spacing: 0.04em;
}
.scroll-pad { height: 220rpx; }

/* ── 底部操作栏（设计文档 §4.5，稿面视口外） ── */
.poem-action-bar {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  background: linear-gradient(180deg, rgba(14, 20, 18, 0) 0%, rgba(14, 20, 18, 0.92) 36%);
  flex: none;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}
.action-btn:active { opacity: 0.78; }
.action-btn--icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  background: rgba(0, 0, 0, 0.32);
  border-radius: 20rpx;
}
.action-ico { width: 36rpx; height: 36rpx; }
.action-ico-btn { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.action-ico-btn--muted { opacity: 0.9; }
.action-btn--primary {
  flex: 1;
  height: 88rpx;
  margin: 0 12rpx;
  background: var(--cinnabar);
  box-shadow: 0 6rpx 20rpx rgba(201, 74, 74, 0.35);
  font-size: 28rpx;
  color: #fffdf8;
  font-weight: 500;
  letter-spacing: 0.06em;
}
.action-btn--secondary {
  flex: 1;
  height: 88rpx;
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 26rpx;
  color: rgba(240, 232, 216, 0.9);
  letter-spacing: 0.04em;
}
.action-btn text {
  font-size: inherit;
  color: inherit;
}
