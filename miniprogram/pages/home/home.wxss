/* 首页：按 Figma 节点 5:2（393 × 852）还原，保留项目设计令牌。 */
.home { position: relative; min-height: 100vh; padding: 0 40rpx 188rpx; background: var(--paper); overflow: hidden; }
.home-search { position: relative; z-index: 1; display: flex; align-items: center; box-sizing: border-box; height: 72rpx; margin-top: 20rpx; padding: 0 26rpx; border-radius: 24rpx; background: var(--paper-sunken); }
.home-search-ico { width: 28rpx; height: 28rpx; margin-right: 14rpx; }.home-search-txt { color: #909594; font-size: 22rpx; }
.daily { position: relative; z-index: 1; height: 406rpx; margin-top: 32rpx; overflow: hidden; border-radius: 42rpx; background: #243f4f; box-shadow: var(--sh-card); }
.daily-moon { position: absolute; top: 92rpx; right: 86rpx; width: 88rpx; height: 88rpx; border-radius: 50%; background: rgba(225, 197, 143, .8); }
.daily-hill { position: absolute; bottom: -156rpx; border-radius: 50% 50% 0 0; }.daily-hill--back { right: -98rpx; width: 520rpx; height: 322rpx; background: #57747a; transform: rotate(22deg); }.daily-hill--front { left: -96rpx; width: 500rpx; height: 294rpx; background: #355664; transform: rotate(-15deg); }
.daily-body { position: relative; display: flex; flex-direction: column; padding: 38rpx 36rpx; }.daily-tag { width: 118rpx; height: 46rpx; color: #fff8ec; background: var(--cinnabar); font-size: 20rpx; letter-spacing: 2rpx; line-height: 46rpx; text-align: center; }.daily-author { margin-top: 20rpx; color: #c7d0cf; font-size: 20rpx; }.daily-title { margin-top: 6rpx; color: var(--paper); font-size: 44rpx; font-weight: bold; letter-spacing: 6rpx; line-height: 1.25; }.daily-lines { margin-top: 14rpx; }.daily-line { display: block; color: var(--paper); font-size: 26rpx; line-height: 1.7; }.daily-cta { display: flex; align-self: flex-start; align-items: center; gap: 16rpx; height: 58rpx; margin-top: 12rpx; padding: 0 26rpx; border-radius: 30rpx; background: var(--paper); color: var(--ink); font-size: 22rpx; }.daily-cta-ico { width: 24rpx; height: 24rpx; }
.cats { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-top: 28rpx; }.cat { display: flex; flex-direction: column; align-items: center; height: 162rpx; padding: 24rpx 8rpx 18rpx; box-sizing: border-box; border-radius: 28rpx; background: var(--paper-card); box-shadow: 0 8rpx 10rpx rgba(70, 65, 51, .06); }.cat-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 20rpx; }.cat-ico { width: 36rpx; height: 36rpx; }.cat-name { margin-top: 12rpx; color: var(--ink); font-size: 22rpx; font-weight: 500; white-space: nowrap; }
.home-section-head { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; height: 82rpx; padding: 20rpx 2rpx 0; box-sizing: border-box; }.home-section-title { color: #1a2520; font-size: 34rpx; font-weight: bold; }
.resume { position: relative; z-index: 1; display: flex; align-items: center; gap: 22rpx; box-sizing: border-box; min-height: 126rpx; padding: 24rpx; border-radius: 32rpx; background: var(--paper-sunken); }.resume-cover { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 84rpx; flex: none; background: var(--cinnabar); color: #fff9ed; font-size: 32rpx; }.resume-main { flex: 1; min-width: 0; }.resume-sub { display: block; color: #838885; font-size: 20rpx; }.resume-title { display: block; margin-top: 2rpx; color: var(--ink); font-size: 28rpx; font-weight: bold; }.resume-bar { height: 6rpx; margin-top: 12rpx; overflow: hidden; border-radius: 6rpx; background: #d8d3c9; }.resume-bar-fill { height: 100%; background: var(--cinnabar); }.resume-tip { display: block; margin-top: 6rpx; color: #858983; font-size: 20rpx; }.resume-percent { color: var(--cinnabar); font-weight: bold; }.resume-go { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; flex: none; border-radius: 25rpx; background: var(--ink); }.resume-go image { width: 26rpx; height: 26rpx; }
.hot { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 16rpx; }.hot-item { display: flex; align-items: center; min-height: 128rpx; padding: 18rpx 22rpx; box-sizing: border-box; border-radius: 28rpx; background: var(--paper-card); box-shadow: 0 8rpx 10rpx rgba(70, 65, 51, .04); }.hot-main { flex: 1; min-width: 0; }.hot-title-row { display: flex; align-items: baseline; min-width: 0; }.hot-title { color: var(--ink); font-size: 26rpx; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.hot-author { color: var(--ink-3); font-size: 20rpx; }.hot-count { display: flex; align-items: center; gap: 8rpx; margin-top: 6rpx; color: #c4756e; font-size: 20rpx; }.hot-count image { width: 22rpx; height: 22rpx; }.hot-play { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; flex: none; border-radius: 50%; background: var(--ink-card); }.hot-play.is-playing { background: var(--cinnabar); }.hot-play-ico { width: 26rpx; height: 26rpx; }
