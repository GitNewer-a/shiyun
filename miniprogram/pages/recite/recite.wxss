/* 记忆训练 · 现代简洁 + 新中式
   色板：#F7F5EF / #FFF / #3F7568 / #252A27 / #747D79 / #E6EFEA / #C9A45C
   禁止背景图与装饰插画
*/

.mem-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx 40rpx 48rpx;
  background: #F7F5EF;
  color: #252A27;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Source Han Sans SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
}

/* —— 介绍 —— */
.intro {
  padding: 24rpx 0 32rpx;
}

.intro-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
  color: #252A27;
}

.intro-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #747D79;
  line-height: 1.5;
}

/* —— 模式 Tab —— */
.mode-scroll {
  width: 100%;
  margin-bottom: 28rpx;
  white-space: nowrap;
}

.mode-tabs {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.mode-tab {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E6E4;
  font-size: 26rpx;
  color: #747D79;
  line-height: 1.2;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.mode-tab.is-active {
  background: #3F7568;
  border-color: #3F7568;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(63, 117, 104, 0.22);
}

/* —— 训练卡片 —— */
.train-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(37, 42, 39, 0.05);
  opacity: 1;
  transition: opacity 0.22s ease;
}

.train-card.is-fading {
  opacity: 0.35;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #E6EFEA;
  font-size: 22rpx;
  color: #3F7568;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.hint-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx 8rpx 12rpx;
}

.hint-btn--hover {
  opacity: 0.65;
}

.hint-label {
  font-size: 26rpx;
  color: #747D79;
}

/* outline 灯泡 */
.bulb-ico {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 28rpx;
}

.bulb-head {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #747D79;
  border-radius: 50% 50% 46% 46%;
  box-sizing: border-box;
}

.bulb-base {
  margin-top: 2rpx;
  width: 12rpx;
  height: 6rpx;
  border: 2rpx solid #747D79;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.poem-head {
  margin-bottom: 24rpx;
}

.poem-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #252A27;
  line-height: 1.35;
}

.poem-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #747D79;
  letter-spacing: 1rpx;
}

.guide-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.guide-pen {
  font-size: 28rpx;
  color: #C9A45C;
  line-height: 1.5;
  flex-shrink: 0;
}

.guide-text {
  flex: 1;
  font-size: 28rpx;
  color: #252A27;
  line-height: 1.55;
  font-weight: 500;
}

/* —— 答题纸 —— */
.paper {
  position: relative;
  height: 520rpx;
  border-radius: 28rpx;
  background: #F4F5F3;
  border: 1rpx solid #E2E6E4;
  overflow: hidden;
}

.paper--short {
  height: 360rpx;
  margin-top: 24rpx;
}

.paper-lines {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  bottom: 0;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 51rpx,
    #E4E8E5 51rpx,
    #E4E8E5 52rpx
  );
  background-position: 0 44rpx;
  pointer-events: none;
  z-index: 0;
}

.paper-input {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 28rpx 28rpx;
  background: transparent;
  border: none;
  font-size: 30rpx;
  line-height: 52rpx;
  color: #252A27;
  letter-spacing: 2rpx;
}

.paper-ph {
  color: #A8B0AC;
  font-size: 28rpx;
}

/* —— 填空 —— */
.blank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.blank-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 20rpx;
  background: #F4F5F3;
  border-radius: 20rpx;
  border: 1rpx solid #E2E6E4;
}

.blank-idx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E6EFEA;
  color: #3F7568;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
}

.blank-body {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx 2rpx;
}

.blank-char {
  font-size: 30rpx;
  color: #252A27;
  letter-spacing: 2rpx;
  line-height: 1.6;
}

.blank-slot {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  margin: 0 2rpx;
  padding: 0;
  text-align: center;
  font-size: 28rpx;
  color: #3F7568;
  font-weight: 600;
  background: #FFFFFF;
  border-bottom: 3rpx solid #3F7568;
  border-radius: 4rpx 4rpx 0 0;
}

/* —— 关键词 —— */
.kw-box {
  padding: 24rpx;
  background: #F7F5EF;
  border-radius: 20rpx;
  border: 1rpx solid #EBE8E0;
}

.kw-label {
  display: block;
  font-size: 22rpx;
  color: #747D79;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.kw-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.kw-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #E6EFEA;
  color: #3F7568;
  font-size: 26rpx;
  font-weight: 500;
}

/* —— 首句接龙 —— */
.chain-box {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chain-step-label {
  font-size: 22rpx;
  color: #C9A45C;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.chain-prev {
  padding: 28rpx;
  background: #E6EFEA;
  border-radius: 20rpx;
}

.chain-prev-label {
  display: block;
  font-size: 22rpx;
  color: #747D79;
  margin-bottom: 10rpx;
}

.chain-prev-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #252A27;
  letter-spacing: 4rpx;
  line-height: 1.5;
}

.chain-ask-label {
  display: block;
  font-size: 26rpx;
  color: #747D79;
  margin-bottom: 16rpx;
}

.chain-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: #F4F5F3;
  border: 1rpx solid #E2E6E4;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #252A27;
  letter-spacing: 2rpx;
}

/* —— 排序 —— */
.order-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-tip {
  font-size: 24rpx;
  color: #747D79;
}

.order-picked,
.order-pool {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-picked {
  min-height: 40rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #E2E6E4;
}

.order-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #F4F5F3;
  border: 1rpx solid #E2E6E4;
  border-radius: 20rpx;
  transition: opacity 0.18s ease, background 0.18s ease;
}

.order-chip.is-picked {
  background: #E6EFEA;
  border-color: #C5D9D1;
}

.order-chip.is-used {
  opacity: 0.35;
  pointer-events: none;
}

.order-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #3F7568;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
}

.order-text {
  font-size: 30rpx;
  color: #252A27;
  letter-spacing: 2rpx;
}

/* —— CTA —— */
.cta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 8rpx;
}

.cta-count {
  font-size: 26rpx;
  color: #747D79;
}

.cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 240rpx;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #3F7568;
  box-shadow: 0 8rpx 20rpx rgba(63, 117, 104, 0.28);
}

.cta-btn--hover {
  opacity: 0.88;
}

.cta-pen {
  font-size: 28rpx;
  color: #FFFFFF;
}

.cta-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* —— 最近练习 —— */
.recent-sec {
  margin-top: 48rpx;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.recent-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #252A27;
  letter-spacing: 2rpx;
}

.recent-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #747D79;
}

.recent-arrow {
  font-size: 28rpx;
  color: #A8B0AC;
  line-height: 1;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(37, 42, 39, 0.04);
}

.recent-body {
  flex: 1;
  min-width: 0;
}

.recent-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #252A27;
  letter-spacing: 2rpx;
}

.recent-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #747D79;
}

.recent-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.done-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.done-check {
  font-size: 24rpx;
  color: #3F7568;
  font-weight: 600;
}

.done-text {
  font-size: 24rpx;
  color: #3F7568;
  font-weight: 500;
}

.acc-text {
  font-size: 22rpx;
  color: #C9A45C;
  font-weight: 500;
}

.bottom-pad {
  height: 48rpx;
}
