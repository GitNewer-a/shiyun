/* 记忆训练 · 作答页（2026-10-19 重构）
   两态同页：作答态（纸 + 输入）/ 判定态（圆环 + 逐字对照）。
   配色只走 app.wxss 令牌，本文件不引入任何独立色板。
   圆角两档：纸与结果卡 --r-md(32rpx)，内部小块 20rpx。
   —— 全局零字符符号铁律：本页不用 ✎ ◯ ✓ ← 等字符做图标，
      「←」只作为「写成→应是」的对照方向符，非图标。 */

.rec-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  background: var(--paper);
  color: var(--ink);
  overflow-x: hidden;
}

/* ---------- 顶部细进度条（填空） ---------- */
.rec-progress {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 20;
  width: 100%;
  height: 4rpx;
  background: rgba(36, 52, 71, .06);
}

.rec-progress-fill {
  height: 100%;
  background: var(--cinnabar);
  transition: width .24s cubic-bezier(.22, .61, .36, 1);
}

/* ---------- 页头 ---------- */
.rec-head {
  padding: 24rpx 0 0;
}

.head-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
}

.mode-tabs {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: var(--paper-sunken);
}

.mode-tab {
  padding: 0 26rpx;
  height: 56rpx;
  border-radius: 28rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 56rpx;
  transition: background .18s ease, color .18s ease;
}

.mode-tab.is-active {
  background: var(--paper-card);
  color: var(--ink);
  font-weight: bold;
}

.hint-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 4rpx 10rpx 10rpx;
}

.hint-ico {
  width: 28rpx;
  height: 28rpx;
}

.hint-label {
  color: var(--ink-3);
  font-size: 22rpx;
}

.is-hover {
  opacity: .6;
}

.rec-title {
  display: block;
  margin-top: 30rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: .14em;
  line-height: 1.35;
}

.rec-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: .04em;
}

/* ---------- 答题纸 ---------- */
.paper {
  margin-top: 34rpx;
  padding: 28rpx 26rpx;
  box-sizing: border-box;
  border-radius: var(--r-md);
  background: var(--paper-card);
  border: 1rpx solid var(--line-faint);
}

/* 稿件高度由内容撑开，最小 320rpx；超出滚动交给 textarea 自身 */
.paper-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 320rpx;
  padding: 0;
  background: transparent;
  border: none;
  color: var(--ink);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 30rpx;
  line-height: 60rpx;
  letter-spacing: .1em;
}

.paper-ph {
  color: var(--ink-5);
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  font-size: 24rpx;
  letter-spacing: .02em;
}

/* ---------- 填空 ---------- */
.blank-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.blank-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 68rpx;
}

.blank-no {
  flex: none;
  width: 28rpx;
  color: var(--ink-5);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 20rpx;
  text-align: center;
}

.blank-body {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.blank-char {
  color: var(--ink);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 30rpx;
  line-height: 1.9;
  letter-spacing: .02em;
}

/* 空格：只有下划线，不作输入框样式，避免整行像表单 */
.blank-slot {
  display: inline-block;
  width: 40rpx;
  height: 46rpx;
  min-width: 40rpx;
  margin: 0 2rpx;
  padding: 0;
  color: var(--ink);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 46rpx;
  text-align: center;
  background: transparent;
  border-bottom: 2rpx solid var(--ink-4);
  border-radius: 0;
  overflow: visible;
}

/* ---------- 提示语 ---------- */
.guide {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 0 4rpx;
}

.guide-mark {
  flex: none;
  color: var(--gold);
  font-size: 24rpx;
  line-height: 1.7;
}

.guide-text {
  flex: 1;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.7;
}

/* ---------- 提交 ---------- */
.cta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.cta-count {
  color: var(--ink-3);
  font-size: 22rpx;
}

.cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 260rpx;
  height: 88rpx;
  padding: 0 44rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background: var(--ink);
}

.cta-label {
  color: var(--paper);
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: .08em;
}

/* ================= 判定态 ================= */
.rs-card {
  margin-top: 34rpx;
  padding: 36rpx 30rpx 30rpx;
  box-sizing: border-box;
  border-radius: var(--r-md);
  background: var(--paper-card);
  border: 1rpx solid var(--line-faint);
}

.rs-top {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

/* conic-gradient 圆环；内圈用卡片同色挖空 */
.rs-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.rs-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--paper-card);
}

.rs-ring-num {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.rs-summary {
  flex: 1;
  min-width: 0;
}

.rs-verdict {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: .06em;
}

.rs-count {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.rs-tip {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ---------- 逐字对照 ---------- */
.rs-lines,
.rs-blank {
  margin-top: 30rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  background: var(--paper-sunken);
}

.rs-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  min-height: 58rpx;
}

.rs-ch {
  position: relative;
  display: inline-block;
  padding: 0 2rpx;
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.82;
  letter-spacing: .04em;
}

.rs-ch.is-ok {
  color: var(--ink);
}

/* 写错的字：朱砂 + 波浪下划线。不用删除线 —— 记忆训练恰恰需要用户看清自己写了什么 */
.rs-ch.is-bad {
  color: var(--cinnabar);
  text-decoration: underline wavy;
  text-decoration-color: var(--cinnabar);
  text-decoration-thickness: 1rpx;
  text-underline-offset: 8rpx;
}

/* 漏写的字：灰色 + 虚线下划线，表示「这里缺一个字」。
   文字用原文的字（不是用户的空），配 gap 类时上面那句三元会取 c.ch。 */
.rs-ch.is-gap {
  color: var(--ink-4);
  text-decoration: underline dashed;
  text-decoration-color: var(--ink-4);
  text-decoration-thickness: 1rpx;
  text-underline-offset: 8rpx;
}

/* 填空判定态：空格用浅底块圈出来，便于扫视 */
.rs-ch--slot {
  margin: 0 1rpx;
  padding: 0 4rpx;
  border-radius: 6rpx;
  background: rgba(36, 52, 71, .04);
}

/* ---------- 订正清单 ---------- */
.fix-sec {
  margin-top: 28rpx;
}

.fix-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 2rpx 14rpx;
}

.fix-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: bold;
}

.fix-legend {
  color: var(--ink-3);
  font-size: 20rpx;
}

.fix-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  background: var(--paper-sunken);
}

.fix-where {
  color: var(--ink-2);
  font-size: 22rpx;
}

.fix-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fix-should {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: bold;
}

.fix-arrow {
  color: var(--ink-4);
  font-size: 22rpx;
}

.fix-got.is-bad {
  color: var(--cinnabar);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 28rpx;
  text-decoration: underline wavy;
  text-decoration-color: var(--cinnabar);
  text-underline-offset: 6rpx;
}

.fix-tag.is-gap {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(36, 52, 71, .05);
  color: var(--ink-3);
  font-size: 18rpx;
}

/* ---------- 结果页操作 ---------- */
.rs-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.btn-ghost,
.btn-solid {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 88rpx;
  text-align: center;
  letter-spacing: .06em;
}

.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--line-faint);
  color: var(--ink-2);
}

.btn-solid {
  background: var(--ink);
  color: var(--paper);
}

.bottom-pad {
  height: 40rpx;
}

@media (prefers-reduced-motion: reduce) {
  .rec-progress-fill,
  .mode-tab {
    transition: none;
  }
}
