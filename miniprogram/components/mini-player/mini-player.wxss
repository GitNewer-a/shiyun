/* 全局悬浮播放器 —— 沉浸系（深墨绿毛玻璃），在宣纸系页面上同样清晰 */

.mp {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 9999;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(26, 40, 34, .94);
  border: 1rpx solid rgba(255, 255, 255, .14);
  box-shadow: 0 10rpx 28rpx rgba(20, 30, 26, .28);
  color: #f0e8d8;
  animation: mp-in .24s ease both;
}

@keyframes mp-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 收起态 ---------- */
.mp-bar {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

.mp-bar-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 12rpx;
}

.mp-disc {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 151, 90, .75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mp-disc-hole {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c9975a;
}

.mp-disc.is-on {
  animation: mp-spin 3.2s linear infinite;
}

@keyframes mp-spin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}

.mp-bar-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.mp-bar-title {
  font-size: 26rpx;
  color: #f0e8d8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mp-bar-sub {
  font-size: 20rpx;
  color: rgba(200, 220, 210, .7);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mp-bar-ctrl {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ---------- 展开态 ---------- */
.mp-panel {
  padding: 22rpx 24rpx 18rpx;
  box-sizing: border-box;
}

.mp-head {
  display: flex;
  align-items: flex-start;
}

.mp-head-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mp-title {
  font-size: 30rpx;
  color: #f0e8d8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mp-sub {
  font-size: 22rpx;
  color: rgba(200, 220, 210, .7);
}

.mp-prog-wrap {
  position: relative;
  margin-top: 26rpx;
  padding: 16rpx 0;
}

.mp-prog-track {
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, .16);
  overflow: hidden;
}

.mp-prog-fill {
  height: 100%;
  border-radius: 3rpx;
  background: rgba(220, 200, 160, .9);
}

.mp-prog-knob {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-top: -9rpx;
  border-radius: 50%;
  background: #dcc8a0;
}

.mp-times {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
}

.mp-time {
  font-size: 20rpx;
  color: rgba(200, 220, 210, .62);
}

.mp-ctrls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.mp-loop {
  flex: none;
  width: 96rpx;
}

.mp-loop-text {
  font-size: 22rpx;
  color: #c9975a;
}

/* ---------- 按钮与图形 ---------- */
.mp-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mp-btn--ghost {
  width: 72rpx;
  height: 72rpx;
}

.mp-btn--play {
  width: 80rpx;
  height: 80rpx;
  background: rgba(201, 151, 90, .92);
}

.mp-btn--lg {
  width: 96rpx;
  height: 96rpx;
}

.mp-ico {
  width: 32rpx;
  height: 32rpx;
}

.mp-ico-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-left: 22rpx solid #22302a;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
}

.mp-ico-pause {
  width: 18rpx;
  height: 24rpx;
  border-left: 6rpx solid #22302a;
  border-right: 6rpx solid #22302a;
}

.mp-chev {
  width: 16rpx;
  height: 16rpx;
  border-left: 3rpx solid rgba(240, 232, 216, .85);
  border-top: 3rpx solid rgba(240, 232, 216, .85);
}

.mp-chev--up { transform: rotate(45deg) translate(3rpx, 3rpx); }
.mp-chev--down { transform: rotate(-135deg) translate(3rpx, 3rpx); }

.mp-x {
  position: relative;
  width: 22rpx;
  height: 3rpx;
  background: rgba(240, 232, 216, .8);
  transform: rotate(45deg);
}

.mp-x::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 22rpx;
  height: 3rpx;
  background: rgba(240, 232, 216, .8);
  transform: rotate(90deg);
}

@media (prefers-reduced-motion: reduce) {
  .mp { animation: none; }
  .mp-disc.is-on { animation: none; }
}
